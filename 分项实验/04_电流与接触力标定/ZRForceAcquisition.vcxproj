<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{AEBCCEA1-C895-43D9-8789-5B4040C4D034}</ProjectGuid>
    <RootNamespace>ZRForceAcquisition</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>MultiByte</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <EntryPoint Condition="'$(EntryPoint)'==''">a0_force_capture</EntryPoint>
    <OutDir>$(ProjectDir)bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)obj\$(Platform)\$(Configuration)\$(EntryPoint)\</IntDir>
    <TargetName>ZRForceAcquisition</TargetName>
    <OutDir Condition="'$(EntryPoint)'=='a0_force_guard'">$(OutDir)$(EntryPoint)\</OutDir>
    <TargetName Condition="'$(EntryPoint)'=='a0_force_guard'">ZRForceGuardPilot</TargetName>
    <OutDir Condition="'$(EntryPoint)'=='a0_open_loop_observer'">$(OutDir)$(EntryPoint)\</OutDir>
    <TargetName Condition="'$(EntryPoint)'=='a0_open_loop_observer'">ZRForceOpenLoopObserver</TargetName>
    <OutDir Condition="'$(EntryPoint)'=='a0_open_loop_handover'">$(OutDir)$(EntryPoint)\</OutDir>
    <TargetName Condition="'$(EntryPoint)'=='a0_open_loop_handover'">ZRForceOpenLoopHandover</TargetName>
    <LocalDebuggerWorkingDirectory>$(OutDir)</LocalDebuggerWorkingDirectory>
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <ExceptionHandling>Sync</ExceptionHandling>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <AdditionalIncludeDirectories>$(ProjectDir)..\02_等效惯性电流辨识\include;$(ProjectDir)..\00_平台配置与基础调试\sdk;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <AdditionalLibraryDirectories>$(ProjectDir)..\00_平台配置与基础调试\sdk\x64;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>gts.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
    <PostBuildEvent>
      <Command>copy /Y "$(ProjectDir)..\00_平台配置与基础调试\sdk\x64\gts.dll" "$(OutDir)gts.dll"
      </Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="src\a0_open_loop_handover.cpp">
      <ExcludedFromBuild Condition="'$(EntryPoint)'!='a0_open_loop_handover'">true</ExcludedFromBuild>
    </ClCompile>
    <ClCompile Include="src\a0_open_loop_observer.cpp">
      <ExcludedFromBuild Condition="'$(EntryPoint)'!='a0_open_loop_observer'">true</ExcludedFromBuild>
    </ClCompile>
    <ClCompile Include="src\a0_force_capture.cpp">
      <ExcludedFromBuild Condition="'$(EntryPoint)'!='a0_force_capture'">true</ExcludedFromBuild>
    </ClCompile>
    <ClCompile Include="src\a0_force_guard.cpp">
      <ExcludedFromBuild Condition="'$(EntryPoint)'!='a0_force_guard'">true</ExcludedFromBuild>
    </ClCompile>
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" />
  </ItemGroup>
  <Target Name="ValidateEntryPoint" BeforeTargets="PrepareForBuild"
          Condition="'$(EntryPoint)'!='a0_force_capture' And '$(EntryPoint)'!='a0_force_guard' And '$(EntryPoint)'!='a0_open_loop_observer' And '$(EntryPoint)'!='a0_open_loop_handover'">
    <Error Text="Unknown EntryPoint: $(EntryPoint)" />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
